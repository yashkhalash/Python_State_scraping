# Optional: Gemini-based data formatting (src/normalizer.py) and the
# selector-free dynamic extraction path (src/dynamic_scraper.py). If unset,
# both fall back to deterministic-only behavior.
GEMINI_API_KEY=

# Optional: additionally persist scraped records to Postgres (src/db.py),
# alongside the JSON/JSONL file output. If unset, only the file output is
# produced. See db/bootstrap.sql and db/schema.sql for one-time setup.
DATABASE_URL=postgresql://procurement_scraper:changeme@localhost:5432/procurement_scraper_db

# Optional: where raw page captures and downloaded documents are stored
# (src/object_storage.py). Defaults to data/object_store if unset.
OBJECT_STORAGE_DIR=data/object_store
